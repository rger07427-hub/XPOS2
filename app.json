{
  "expo": {
    "name": "XPOS2",
    "slug": "pos-app2",
    "version": "1.1.0",
    "scheme": "posapp",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E98A8"
      },
      "package": "com.posapp.epos.cabang2",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FA"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
